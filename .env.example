# Copy to .env and adjust as needed. All values have sane defaults baked
# into backend/app/config.py, so .env is optional for local dev.

# URL of the ESP32/BME680 sensor node's /env endpoint.
# Confirm this hasn't changed before deploying (same IP the kiosk's
# CFG_ENV_SENSOR_URL points at).
ESP32_ENV_URL=http://192.168.64.20/env

# How often to poll the sensor, in seconds. This app is about trends,
# not instant reaction, so it polls slower than the kiosk does.
POLL_INTERVAL_SECONDS=15

# Where the SQLite database file lives. In Docker this should point at
# the mounted volume (see docker-compose.yml).
DB_PATH=./data/env.db

# How many days of history to retain before the daily prune job deletes it.
RETENTION_DAYS=30

# Port the FastAPI/Uvicorn server listens on *inside* the container.
# Left at 8090 -- on Proteus the host-side port had to change instead
# (8090/8091 were already taken by other services), so see the "ports:"
# mapping in docker-compose.yml (currently 8095:8090) rather than this.
PORT=8090
